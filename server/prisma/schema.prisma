generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImageStatus {
  QUEUED
  PROCESSING
  DONE
  ERROR
}

model Image {
  id           String      @id @default(uuid())
  originalKey  String
  processedKey String?
  status       ImageStatus @default(QUEUED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
